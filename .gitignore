# =============================================================================
# AURA Desktop AR Companion System — .gitignore
# =============================================================================

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.spec

# Virtual Environments
.venv/
venv/
env/
ENV/
.env/

# Environment variables / secrets
.env
.env.local
.env.*.local
*.env
secrets.json
config.secret.*

# ─── Node / Electron / Frontend ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# Build output
aura_app/frontend/dist/
aura_app/frontend/dist-electron/
aura_app/frontend/.vite/
aura_app/frontend/out/
aura_app/frontend/release/

# Electron packaged app
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.snap
*.nsis

# ─── IDE / Editor Configs ────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor/
.windsurf/

# ─── OS Generated Files ──────────────────────────────────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.lnk

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Linux
*~
.directory

# ─── Vendored / Bundled Python Libraries ─────────────────────────────────────
# Pip packages bundled in libs/ should not be tracked
aura_app/backend/libs/

# ─── AI / ML Model Caches ────────────────────────────────────────────────────
# MediaPipe, PyTorch, EasyOCR model weights (can be re-downloaded)
*.pt
*.pth
*.onnx
*.tflite
*.caffemodel
*.pkl
*.pickle
models/
.cache/
easyocr_models/

# Re-include the RKNN hand model bundle: Apache-2.0, license texts kept alongside.
!aura_app/backend/models/
aura_app/backend/models/*
!aura_app/backend/models/rknn/

# ─── Logs & Temp Files ───────────────────────────────────────────────────────
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
logs/
temp/
tmp/

# ─── Test & Coverage Reports ─────────────────────────────────────────────────
.coverage
coverage/
htmlcov/
*.xml
junit*.xml

# ─── Audio / Video Captures (usually auto-generated by AURA) ─────────────────
*.wav
*.mp3
*.ogg
*.mp4
*.avi
*.mkv
aura_recordings/
snapshots/

# ─── Database & Session Artifacts ────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
session_data/

# ─── Icon & Asset Build Artifacts ────────────────────────────────────────────
# Keep the master icon, exclude generated sizes
# aura_icon.ico is kept (tracked)
*.bmp
icon_*.png

# ─── Gemini / AI Assistant Workspace Files ───────────────────────────────────
.gemini/
.antigravity/

# User-supplied avatar: embedded license prohibits redistribution.
/AAA.vrm

# VRM avatar assets are kept out of the source repository.
/AAA2.vrm

# Downloaded VRoid avatar and local backups: keep model files out of Git.
/AvatarSample_A.vrm
/aura_app/frontend/public/characters/AvatarSample_A.vrm
/model/ChestnutBobGirl.vrm
/aura_app/frontend/public/characters/chestnut-bob-girl/ChestnutBobGirl.vrm
