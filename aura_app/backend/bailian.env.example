# Save in repository root .env or ~/.config/aura/bailian.env, chmod 600.
# Priority: process environment > root .env > backend .env > private config.
# Do NOT commit or paste your real key into chat.
AURA_PROVIDER=bailian
DASHSCOPE_API_KEY=
# Beijing models and their matching voice (do not mix v2/v3 voices).
AURA_LLM_MODEL=qwen-plus
AURA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AURA_ASR_MODEL=paraformer-realtime-v2
# Recognition language hints, independent of UI/reply language. Use en for English-only input.
# Optional; defaults to en,zh for paraformer-realtime-v2. Not supported by the 8 kHz model.
AURA_ASR_LANGUAGES=en,zh
AURA_TTS_MODEL=cosyvoice-v3-plus
AURA_BAILIAN_VOICE=longanhuan
AURA_BAILIAN_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# If your workspace requires the new regional endpoints, use the matching
# Beijing workspace URLs from the Bailian console for BOTH LLM and WebSocket.
# Microphone: USB camera microphone on this board. Check "arecord -l" first.
AURA_MIC_DEVICE=plughw:CARD=U2K,DEV=0
